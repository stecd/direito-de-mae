# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# A Portuguese-sounding voice from elevenlabs.io > Voices (copy its Voice ID)
ELEVENLABS_VOICE_ID=

# Twilio console > Account info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your free static ngrok domain, e.g. https://something.ngrok-free.app
PUBLIC_URL=
# Set to 0 only if signature checks fail while debugging
TWILIO_VALIDATE=1

# Any long random string (makes stored file names unguessable)
HASH_SALT=

# Encrypts every stored file. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes all stored data unreadable. Never commit it.
MASTER_KEY=

# Voice replies (ElevenLabs TTS). 0 = text only (saves credits). Set 1 for the demo.
# Incoming voice notes are transcribed either way.
VOICE_REPLIES=0
