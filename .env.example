# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# A Portuguese-sounding voice from elevenlabs.io > Voices (copy its Voice ID)
ELEVENLABS_VOICE_ID=

# Twilio console > Account info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Your free static ngrok domain, e.g. https://something.ngrok-free.app
PUBLIC_URL=
# Set to 0 only if signature checks fail while debugging
TWILIO_VALIDATE=1

# Any long random string (makes stored file names unguessable)
HASH_SALT=
